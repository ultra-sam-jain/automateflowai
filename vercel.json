{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/andres/?$", "dest": "/index.html" },
    { "src": "/andres/athletes/?$", "dest": "/index.html" },
    { "src": "/andres/about/?$", "dest": "/index.html" },
    { "src": "/gym/?$", "dest": "/index.html" },
    { "src": "/baseball/?$", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 307, "headers": { "Location": "/" } }
  ]
}
